    {
      "id": "1bab6709-099a-474a-9c02-a1866b8f0aff",
      "name": "Score results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Score results: compare each Knowledge Assistant reply with the expected result.\nconst cases = $('Get eval questions').all().map(i => i.json);\nconst replies = $input.all().map(i => i.json);\n\nlet retrievalHits = 0, citationsCorrect = 0, factsFound = 0;\nlet correctRefusals = 0, falseRefusals = 0, byThreshold = 0, byAi = 0;\nconst mistakes = [];\nconst details = [];\n\ncases.forEach((c, i) => {\n  const r = replies[i] || {};\n  const retrieved = String(r.retrieved_ids || '').split(',').map(s => s.trim()).filter(Boolean);\n  const retrievedDocs = retrieved.map(id => id.split('-')[0]);\n  const cited = String(r.sources || '').split(',').map(s => s.trim()).filter(Boolean);\n  const answered = r.status === 'answered';\n  const row = { q_id: c.q_id, status: r.status, top_score: r.top_score, retrieved: retrieved.join(' '), cited: cited.join(' ') };\n\n  if (c.should_answer) {\n    const hit = retrievedDocs.includes(c.expected_doc_id);\n    const citeOk = answered && cited.length > 0 && cited.every(s => retrieved.includes(s)) &&\n      cited.some(s => s.split('-')[0] === c.expected_doc_id);\n    const factOk = answered && String(r.answer || '').toLowerCase().includes(String(c.expected_keyword).toLowerCase());\n    if (hit) retrievalHits++; else mistakes.push(c.q_id + ': expected ' + c.expected_doc_id + ' not in top results');\n    if (citeOk) citationsCorrect++; else if (answered) mistakes.push(c.q_id + ': wrong citation (' + cited.join(' ') + ')');\n    if (factOk) factsFound++; else if (answered) mistakes.push(c.q_id + ': answer missing \"' + c.expected_keyword + '\"');\n    if (!answered) { falseRefusals++; mistakes.push(c.q_id + ': refused (' + r.status + ')'); }\n    Object.assign(row, { hit, citeOk, factOk });\n  } else {\n    if (r.status === 'ai_error') {\n      mistakes.push(c.q_id + ': said \"I don\\'t know\" only because the AI call failed');\n    } else if (!answered) {\n      correctRefusals++;\n      if (r.status === 'no_match') byThreshold++; else byAi++;\n    } else {\n      mistakes.push(c.q_id + ': answered a question the docs do not cover');\n    }\n    Object.assign(row, { refusedOk: !answered && r.status !== 'ai_error' });\n  }\n  details.push(row);\n});\n\nreturn [{ json: {\n  questions: cases.length,\n  retrieval_hits: retrievalHits,\n  citations_correct: citationsCorrect,\n  facts_found: factsFound,\n  correct_refusals: correctRefusals,\n  false_refusals: falseRefusals,\n  refused_by_threshold: byThreshold,\n  refused_by_ai: byAi,\n  mistakes: mistakes.length ? mistakes.join('; ') : 'none',\n  details\n} }];\n"
      }
    },
